# Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar — Option A: OAuth2 (recommended for personal calendars)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/callback
GOOGLE_REFRESH_TOKEN=

# Google Calendar — Option B: Service Account
# Set the path to your service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Athlytic → Claude connector (see ATHLYTIC.md) ---
# Required for health-data uploads. Generate one with: openssl rand -hex 24
ATHLYTIC_INGEST_TOKEN=
# Recommended: secret path for the Claude connector endpoint (/mcp/<MCP_TOKEN>).
# Generate a different one with: openssl rand -hex 24
MCP_TOKEN=
# Where health data is stored (default: ./data). Point at a mounted volume in production.
# DATA_DIR=/data
