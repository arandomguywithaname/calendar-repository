# Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# --- ICS Download (default) ---
# No extra credentials needed! Events are downloaded as .ics files
# that work with any calendar app (Google Calendar, Apple Calendar, Outlook, etc.)

# --- Google Calendar Direct Integration (optional) ---
# Only needed if you want to create events directly in Google Calendar.
# You can skip these and use the .ics download instead.

# Option A: OAuth2 (recommended for personal calendars)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/callback
# GOOGLE_REFRESH_TOKEN=

# Option B: Service Account
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
