# Claude API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar — Option A: OAuth2 (recommended for personal calendars)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/callback
GOOGLE_REFRESH_TOKEN=

# Google Calendar — Option B: Service Account
# Set the path to your service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Apple Health → Claude connector (see APPLE_HEALTH.md) ---
# Required for health-data uploads. Generate both with: npm run tokens
# (the old ATHLYTIC_INGEST_TOKEN name is still accepted)
HEALTH_INGEST_TOKEN=
# Recommended: secret path for the Claude connector endpoint (/mcp/<MCP_TOKEN>).
MCP_TOKEN=
# Where health data is stored (default: ./data). Point at a mounted volume in production.
# DATA_DIR=/data

# --- Browser → Claude connector (see BROWSER.md) ---
# Runs locally on the machine with the screen; nothing here belongs on a server.
# How it gets a browser: attach (your own Chrome), profile (its own), auto (try attach first).
# BROWSER_MODE=auto
# BROWSER_CDP_URL=http://127.0.0.1:9222
# BROWSER_PROFILE_DIR=
# Restrict which sites Claude may open. Empty means no restriction.
# BROWSER_ALLOWED_DOMAINS=amazon.de,decathlon.fr
# "never" (default) blocks every order/payment button. "confirm" allows one you have
# explicitly approved in the conversation. There is no setting that skips a CAPTCHA.
# BROWSER_ALLOW_PURCHASE=never
# BROWSER_TIMEOUT_MS=45000
