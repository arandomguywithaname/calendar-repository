# Claude API key (required — powers the summaries and the ask-the-AI box)
ANTHROPIC_API_KEY=sk-ant-...

# Session signing secret (required in production — sessions reset on restart without it)
SESSION_SECRET=

# --- Sign in with Google (OAuth2) ---------------------------------------
# Real Google sign-in: the user types their password on accounts.google.com,
# never in this app. Create credentials at console.cloud.google.com and add
# the redirect URI below to the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Local sign-in without Google (no password). Defaults to on when the Google
# credentials above are missing. Set to "false" to turn it off entirely.
ALLOW_DEMO_SIGNIN=

# --- Message sources ----------------------------------------------------
# Each app falls back to demo data when its credentials are missing.

# Telegram: create a bot with @BotFather, then add it to the groups/channels
# you want summarised. The Bot API cannot read personal DMs.
TELEGRAM_BOT_TOKEN=

# Slack: a bot token (xoxb-) reads conversations the app was invited to.
# A user token (xoxp-) additionally gives accurate unread counts.
# Scopes: channels:read, groups:read, im:read, channels:history,
#         groups:history, im:history, users:read
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# WhatsApp Business Cloud API: point the webhook at
# https://<your-host>/webhooks/whatsapp using this verify token.
# WHATSAPP_APP_SECRET enables signature checking on inbound deliveries.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Calendar agent (the original tool, still at /calendar) --------------
GOOGLE_REFRESH_TOKEN=
# Or a service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
