# ---------------------------------------------------------------------------
# Paste your two values below, save this file, then run the bot.
# ---------------------------------------------------------------------------

# 1. Open @BotFather in Telegram, send /newbot, paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# 2. Go to https://my.telegram.org -> API development tools.
#    Create an app (any name), then copy the two values it shows.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# ---------------------------------------------------------------------------
# Optional. The bot works without anything below.
# ---------------------------------------------------------------------------

# Better summaries. Without this the bot still reads your real channels, but it
# groups them by shared wording instead of by meaning — so the same story told
# two different ways may appear twice. It says so on screen when that happens.
ANTHROPIC_API_KEY=

# How often it builds a digest on its own, in hours. 0 turns it off.
DIGEST_INTERVAL_HOURS=6
